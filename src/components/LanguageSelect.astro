---
import DefaultLanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---
{Astro.locals.starlightRoute.id === '404' ? (
  <nav aria-label="Language" class="error-languages">
    <a href={base} lang="en">English</a>
    <a href={`${base}de/`} lang="de">Deutsch</a>
    <a href={`${base}es/`} lang="es">Español</a>
  </nav>
) : <DefaultLanguageSelect />}
<style>
  .error-languages { display: flex; gap: 0.75rem; flex-wrap: wrap; font-size: var(--sl-text-sm); }
</style>
