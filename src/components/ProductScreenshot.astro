---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  lang?: 'en' | 'de' | 'es';
}

const { src, alt, caption, lang = 'en' } = Astro.props;
const labels = {
  en: { open: 'Open full-size screenshot', size: 'View full size' },
  de: { open: 'Screenshot in voller Größe öffnen', size: 'In voller Größe ansehen' },
  es: { open: 'Abrir captura a tamaño completo', size: 'Ver a tamaño completo' },
}[lang];
// Astro's dev file URL needs the same base path as the docs server.
const fullSizeSrc = import.meta.env.DEV && src.src.startsWith('/@fs/')
  ? `${import.meta.env.BASE_URL.replace(/\/$/, '')}${src.src}`
  : src.src;
---

<figure class="product-screenshot">
  <a href={fullSizeSrc} aria-label={`${labels.open}: ${alt}`}>
    <Image src={src} alt={alt} loading="lazy" format="webp" quality={90} />
  </a>
  <figcaption>
    {caption}{' '}
    <a href={fullSizeSrc}>{labels.size}</a>
  </figcaption>
</figure>

<style>
  .product-screenshot { margin: 1.75rem 0; }
  .product-screenshot > a { display: block; width: fit-content; max-width: 100%; }
  .product-screenshot img {
    display: block;
    height: auto;
    max-width: 100%;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
  }
  .product-screenshot figcaption {
    margin-top: 0.65rem;
    color: var(--sl-color-gray-2);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .product-screenshot figcaption a { margin-inline-start: 0.5em; white-space: nowrap; }
</style>
